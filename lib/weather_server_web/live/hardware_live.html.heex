<Layouts.app flash={@flash} header_title={@header_title} theme={@theme} active_nav={@active_nav}>
  <div class="h-full grid grid-cols-4 grid-rows-[290px_1fr] gap-3">
    <%= for {device, index} <- Enum.with_index(@devices) do %>
      <.panel class="p-4">
        <%= if device do %>
          <div class="flex h-full flex-col justify-between gap-4">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="text-base font-semibold text-base-content">{device.name}</p>
              </div>
              <span
                class={[
                  "device-status-dot",
                  device.online && "device-status-dot--online",
                  !device.online && "device-status-dot--offline"
                ]}
                title={if(device.online, do: "Online", else: "Offline")}
              >
              </span>
            </div>

            <div class="flex items-end justify-between">
              <.bar_metric
                label="CPU"
                value={device.cpu_percent}
                max={100.0}
                active_class="bg-primary/80"
                muted_class="bg-base-300/70"
              />
              <.bar_metric
                label="MEM"
                value={device.ram_percent}
                max={100.0}
                active_class="bg-accent/80"
                muted_class="bg-base-300/70"
              />
              <.bar_metric
                label="TEMP"
                value={device.cpu_percent}
                max={90.0}
                active_class="bg-warning/80"
                muted_class="bg-base-300/70"
              />
            </div>

            <div class="grid gap-1 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-base-content/60">Disk</span>
                <span class="font-semibold text-base-content">62%</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-base-content/60">Net</span>
                <span class="font-semibold text-base-content">12Kbs↓ / 1Kbs↑</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-base-content/60">Load</span>
                <span class="font-semibold text-base-content">0.42</span>
              </div>
            </div>

            <div class="flex items-center justify-between text-xs text-base-content/70">
              <span>Uptime</span>
              <span class="font-semibold text-base-content">
                {format_uptime(device.uptime_seconds)}
              </span>
            </div>
          </div>
        <% else %>
          <div class="flex h-full flex-col items-center justify-center text-sm text-base-content/40">
            <.icon name="hero-cube-transparent" class="size-8" />
            <span class="mt-2">Empty slot</span>
          </div>
        <% end %>
      </.panel>
    <% end %>
  </div>
</Layouts.app>
