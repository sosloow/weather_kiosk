<Layouts.app flash={@flash} header_title={@header_title} theme={@theme} active_nav={@active_nav}>
  <div id="settings-shell" class="h-full min-h-0 grid grid-cols-[240px_1fr] gap-4">
    <aside
      id="settings-sidebar"
      class="
        flex flex-col gap-3
        bg-base-200/80 border border-base-300/70
        rounded-2xl p-3
        shadow-lg backdrop-blur
        glossy-top-border
      "
    >
      <.link
        patch={~p"/settings?section=appearance"}
        class={[
          "group rounded-2xl border px-4 py-4 transition-all duration-200",
          @section == "appearance" && "bg-primary/15 border-primary/40 shadow-lg",
          @section != "appearance" &&
            "bg-base-200/50 border-base-300/60 hover:bg-base-200/80 hover:border-base-300"
        ]}
      >
        <div class="flex items-center gap-4">
          <div class={[
            "flex size-12 items-center justify-center rounded-2xl transition-colors duration-200",
            @section == "appearance" && "bg-primary/20 text-primary",
            @section != "appearance" && "bg-base-300/70 text-base-content/70"
          ]}>
            <.icon name="hero-paint-brush" class="size-6" />
          </div>
          <div>
            <p class="text-sm font-semibold">Appearance</p>
            <p class="text-xs text-base-content/60">Themes and styling</p>
          </div>
        </div>
      </.link>
      <.link
        patch={~p"/settings?section=network"}
        class={[
          "group rounded-2xl border px-4 py-4 transition-all duration-200",
          @section == "network" && "bg-primary/15 border-primary/40 shadow-lg",
          @section != "network" &&
            "bg-base-200/50 border-base-300/60 hover:bg-base-200/80 hover:border-base-300"
        ]}
      >
        <div class="flex items-center gap-4">
          <div class={[
            "flex size-12 items-center justify-center rounded-2xl transition-colors duration-200",
            @section == "network" && "bg-primary/20 text-primary",
            @section != "network" && "bg-base-300/70 text-base-content/70"
          ]}>
            <.icon name="hero-wifi" class="size-6" />
          </div>
          <div>
            <p class="text-sm font-semibold">Network</p>
            <p class="text-xs text-base-content/60">Hardware inventory</p>
          </div>
        </div>
      </.link>
    </aside>

    <section id="settings-content" class="h-full min-h-0 flex">
      <%= if @section == "appearance" do %>
        <.panel class="flex-1 p-6">
          <div class="flex flex-col gap-6">
            <div class="flex items-start justify-between">
              <div>
                <h2 class="text-xl font-semibold text-base-content">Appearance</h2>
                <p class="text-sm text-base-content/60">
                  Pick a daisyUI theme that matches the room.
                </p>
              </div>
              <div class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                Live preview
              </div>
            </div>

            <.form for={@form} id="appearance-form" phx-change="update_theme" class="max-w-xs">
              <.input
                field={@form[:theme]}
                type="select"
                label="DaisyUI Theme"
                options={@theme_options}
              />
            </.form>

            <div class="text-xs text-base-content/60">
              Theme changes apply instantly across the dashboard.
            </div>
          </div>
        </.panel>
      <% else %>
        <.panel class="flex-1 p-6" scroll_y={true}>
          <div class="flex flex-col gap-6 min-h-0">
            <div class="flex items-start justify-between">
              <div>
                <h2 class="text-xl font-semibold text-base-content">Network inventory</h2>
                <p class="text-sm text-base-content/60">
                  Define the devices that feed Prometheus metrics.
                </p>
              </div>
              <div class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                {length(@devices)} devices
              </div>
            </div>

            <.form for={%{}} id="devices-form" phx-submit="save_devices" class="flex-1 min-h-0">
              <div class="flex flex-col gap-4">
                <%= for {device, index} <- Enum.with_index(@devices) do %>
                  <div class="rounded-2xl border border-base-300/70 bg-base-200/60 p-4 shadow-lg">
                    <div class="flex items-start justify-between gap-4">
                      <div class="grid grid-cols-2 gap-4 flex-1">
                        <.input
                          name={"devices[#{index}][id]"}
                          value={device.id}
                          label="Device ID"
                          placeholder="rp5"
                          errors={Map.get(@device_errors, index, %{}) |> Map.get(:id, [])}
                        />
                        <.input
                          name={"devices[#{index}][name]"}
                          value={device.name}
                          label="Name"
                          placeholder="Raspberry Pi 5"
                          errors={Map.get(@device_errors, index, %{}) |> Map.get(:name, [])}
                        />
                        <.input
                          name={"devices[#{index}][role]"}
                          value={device.role}
                          type="select"
                          label="Role"
                          options={@device_role_options}
                          errors={Map.get(@device_errors, index, %{}) |> Map.get(:role, [])}
                        />
                        <.input
                          name={"devices[#{index}][metrics_instance]"}
                          value={device.metrics_instance}
                          label="Metrics Instance"
                          placeholder="rp5"
                          errors={
                            Map.get(@device_errors, index, %{}) |> Map.get(:metrics_instance, [])
                          }
                        />
                      </div>
                      <button
                        type="button"
                        phx-click="remove_device"
                        phx-value-index={index}
                        class="btn btn-ghost btn-sm text-base-content/60 hover:text-error"
                      >
                        <.icon name="hero-trash" class="size-4" />
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>

              <div class="mt-6 flex items-center justify-between">
                <button type="button" phx-click="add_device" class="btn btn-ghost">
                  <.icon name="hero-plus" class="size-4" /> Add device
                </button>
                <.button type="submit" variant="primary">Save inventory</.button>
              </div>
            </.form>
          </div>
        </.panel>
      <% end %>
    </section>
  </div>
</Layouts.app>
