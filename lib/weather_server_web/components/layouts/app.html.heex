<div
  id="app-shell"
  phx-hook="ThemeManager"
  data-theme={assigns[:theme] || "night"}
  class="
    w-[1024px] h-[600px] fixed top-0 left-0
    grid grid-cols-[1fr_80px] grid-rows-[auto_1fr]
    p-3 gap-3
    bg-base-300
    overflow-hidden
    select-none
  "
>
  <header class="
      col-span-2
      flex justify-between items-center
      px-4 py-2.5
      bg-base-200/90 border border-base-300/70
      rounded-2xl shadow-lg backdrop-blur
      glossy-top-border
    ">
    <div class="flex flex-col gap-0.5" phx-hook="Clock" id="clock">
      <div
        id="time-display"
        class="
          text-[28px] font-semibold leading-none
          text-base-content drop-shadow-lg
        "
      >
        --:--
      </div>
      <div
        id="date-display"
        class="
          text-xs font-medium leading-none tracking-[0.5px]
          text-base-content/70
        "
      >
        -- --- --
      </div>
    </div>
    <div
      id="location"
      class="
        text-base font-medium
        text-base-content/80
      "
    >
      {if assigns[:header_title], do: @header_title, else: ""}
    </div>
    <div
      id="status"
      class="
        inline-flex items-center gap-1.5
        px-3 py-1.5 rounded-[20px]
        text-xs font-semibold uppercase tracking-[0.5px]
        bg-success/15 text-success border border-success/30
      "
    >
      <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Online
    </div>
  </header>

  <main id="page-content" class="col-span-2 row-start-2 min-h-0 h-full">
    <%= if assigns[:inner_block] do %>
      {render_slot(@inner_block)}
    <% else %>
      {@inner_content}
    <% end %>
  </main>

  <nav class="
      col-start-3 row-span-2
      flex flex-col gap-2
      h-full
      p-2
      bg-base-200/90 border border-base-300/70
      rounded-2xl shadow-lg backdrop-blur
      glossy-top-border
      items-center justify-start
      overflow-y-auto
    ">
    <.link
      navigate={~p"/weather"}
      data-page="weather"
      class={[
        "group flex items-center justify-center w-full aspect-square rounded-2xl transition-all duration-200",
        assigns[:active_nav] == :weather && "bg-primary/20 border border-primary/40 shadow-md",
        assigns[:active_nav] != :weather &&
          "bg-transparent border border-transparent hover:bg-base-200/60 hover:border-base-300/60"
      ]}
    >
      <.icon
        name="hero-cloud"
        class={[
          "size-10 transition-colors duration-200",
          assigns[:active_nav] == :weather && "text-primary",
          assigns[:active_nav] != :weather && "text-base-content/70 group-hover:text-base-content"
        ]}
      />
    </.link>
    <.link
      navigate={~p"/hardware"}
      data-page="hardware"
      class={[
        "group flex items-center justify-center w-full aspect-square rounded-2xl transition-all duration-200",
        assigns[:active_nav] == :hardware && "bg-primary/20 border border-primary/40 shadow-md",
        assigns[:active_nav] != :hardware &&
          "bg-transparent border border-transparent hover:bg-base-200/60 hover:border-base-300/60"
      ]}
    >
      <.icon
        name="hero-server-stack"
        class={[
          "size-10 transition-colors duration-200",
          assigns[:active_nav] == :hardware && "text-primary",
          assigns[:active_nav] != :hardware &&
            "text-base-content/70 group-hover:text-base-content"
        ]}
      />
    </.link>
    <.link
      navigate={~p"/settings"}
      data-page="settings"
      class={[
        "group flex items-center justify-center w-full aspect-square rounded-2xl transition-all duration-200",
        assigns[:active_nav] == :settings && "bg-primary/20 border border-primary/40 shadow-md",
        assigns[:active_nav] != :settings &&
          "bg-transparent border border-transparent hover:bg-base-200/60 hover:border-base-300/60"
      ]}
    >
      <.icon
        name="hero-cog-6-tooth"
        class={[
          "size-10 transition-colors duration-200",
          assigns[:active_nav] == :settings && "text-primary",
          assigns[:active_nav] != :settings &&
            "text-base-content/70 group-hover:text-base-content"
        ]}
      />
    </.link>
  </nav>
</div>
<.flash_group flash={@flash} />
